{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"],
      "#/models": ["./src/models"],
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
